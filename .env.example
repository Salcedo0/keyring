# Variables del despliegue con Docker. En la VM, copia este archivo como .env (junto a
# docker-compose.yml) y cambia los valores. IP_DE_LA_VM es la IP externa de la máquina en GCP.

# Dirección de la API tal como la ve el navegador (queda escrita dentro del bundle del frontend).
VITE_API_BASE_URL=http://IP_DE_LA_VM:3000

# Direcciones del frontend que pueden llamar a la API, separadas por coma.
CORS_ORIGIN=http://IP_DE_LA_VM

# Clave para firmar las sesiones: texto largo y aleatorio, distinto al de desarrollo.
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio

# Primer administrador: se crea una sola vez, al primer arranque.
ADMIN_NOMBRE=Administrador KeyRing
ADMIN_CORREO=admin@keyring.co
ADMIN_CONTRASENA=cambia-esta-contrasena

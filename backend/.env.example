# Copia este archivo como .env y cambia los valores.

# Puerto donde escucha la API.
PORT=3000

# Direcciones del frontend que pueden llamar a la API, separadas por coma.
CORS_ORIGIN=http://localhost:5173

# Archivo de la base de datos SQLite. Si no se pone, se usa backend/database.sqlite.
# SQLITE_PATH=/data/database.sqlite

# Clave para firmar los tokens de sesión. Obligatoria: la API no arranca sin ella.
# Usa un texto largo y aleatorio, distinto en cada servidor.
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio

# Primer administrador. Se crea solo una vez, la primera vez que arranca la API y no hay ningún ADMIN.
ADMIN_NOMBRE=Administrador KeyRing
ADMIN_CORREO=admin@keyring.co
ADMIN_CONTRASENA=cambia-esta-contrasena
